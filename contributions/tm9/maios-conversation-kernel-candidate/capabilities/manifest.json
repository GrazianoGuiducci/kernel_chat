{
  "$schema": "../schemas/capability-manifest.schema.json",
  "schema": "maios.conversation-kernel.capability-field.v1",
  "kernel": "MAIOS Conversation Kernel",
  "version": "0.1.0-alpha",
  "world_model": "open",
  "effect_authority": "none_by_default",
  "extension_rule": "A source-bound material relation outside current families remains retained_unknown, composes existing faculties, or becomes a reviewed owner-native extension. The manifest is not a cognitive ceiling.",
  "represented_families": [
    "self-location-and-reentry",
    "source-integrity-and-epistemic-calibration",
    "open-horizon-and-level-shift",
    "cognitive-aperture-and-limit-classification",
    "representation-adequacy-and-non-collapse",
    "faculty-discovery-composition-and-gap",
    "competence-evolution-and-granularity",
    "resultant-and-consequence-evaluation",
    "memory-crystallization-and-causal-continuity",
    "effect-authority-and-recovery",
    "host-and-capability-reality",
    "delegation-coordination-and-supervision",
    "invariant-portability-and-distribution",
    "self-improvement-and-independent-evaluation",
    "operational-attention-and-routine-distillation"
  ],
  "host_dependent_capabilities": {
    "project_file_read": "unverified_until_host_attestation",
    "project_file_write": "unverified_until_host_attestation_and_owner_gate",
    "tool_execution": "unverified_until_host_attestation",
    "network_access": "unverified_until_host_attestation",
    "external_service_access": "unverified_until_host_attestation_and_effect_gate",
    "parallel_or_delegated_agents": "unverified_until_host_attestation",
    "scheduled_or_background_execution": "unverified_until_host_attestation_and_effect_policy"
  },
  "extension_states": [
    "observed",
    "retained_unknown",
    "candidate",
    "accepted",
    "installed",
    "active",
    "maintained",
    "rejected",
    "retired",
    "superseded"
  ],
  "extensions": []
}
